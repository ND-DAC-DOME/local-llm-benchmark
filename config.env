# Shared settings for every script in this repo. Override any of these in config.local.env (git-ignored)
# or in the environment. Images are pinned by digest so a re-run uses the exact binaries of the original runs.

# Where Hugging Face weights are cached on the host (mounted into the containers).
HF_CACHE=${HF_CACHE:-$HOME/.cache/huggingface}

# llama.cpp server, build 11011 (commit aa39d7a3e), pulled 2026-09-17 as ghcr.io/ggml-org/llama.cpp:server-cuda
LLAMACPP_IMAGE=${LLAMACPP_IMAGE:-ghcr.io/ggml-org/llama.cpp@sha256:95cdc1510dbc5bc15735529353d72ace9fc96b9aeb0dd6c4cdaf1a6b3f70776f}

# vLLM 0.29.0 (x86_64), pulled 2026-09-18 as vllm/vllm-openai:latest
VLLM_IMAGE=${VLLM_IMAGE:-vllm/vllm-openai@sha256:c2914767605584b6d8f45686b82de173ecc99e781897aa3d0a66dacd72c51ae1}

# OpenAI-compatible endpoint of the DGX Spark (only needed by runs/05 and tools/). No default on purpose: set it yourself.
SPARK_URL=${SPARK_URL:-}
# API key the Spark's server expects (sent as "Authorization: Bearer ..."). Keep it in config.local.env or .env, never here.
SPARK_API_KEY=${SPARK_API_KEY:-}
# The Spark serves HTTPS with a private CA. Point SSL_CERT_FILE (Python) and CURL_CA_BUNDLE (curl) at its public root
# certificate once you have it; until then SPARK_INSECURE=1 skips verification (identification only, not security).
SSL_CERT_FILE=${SSL_CERT_FILE:-${SPARK_CA_BUNDLE:-}}
CURL_CA_BUNDLE=${CURL_CA_BUNDLE:-${SPARK_CA_BUNDLE:-}}
SPARK_INSECURE=${SPARK_INSECURE:-}
